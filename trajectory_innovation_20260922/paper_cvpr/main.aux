\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Conditional Trajectory Abstraction.} \emph  {Top:} at each decision, the history is encoded once into a context $C$ of frozen DINOv2 features, and a frozen policy proposes $K$ action chunks. The world model, a joint-embedding predictor, forecasts for each chunk a short discrete code $\hat  S$ of the chunk's entire future segment, conditioned on $C$. A reader that sees $C$ and the code, but never the action, scores each code against goal images. Since codes do not depend on the goal, one prediction per candidate serves any number of goals. \emph  {Bottom:} during training, a target encoder compresses the actual future segment into the code given $C$. A reader ranks sibling candidates by their progress labels, and a decoder reconstructs the future's frozen features from $(C,S)$. The world model learns to predict the stop-gradient code; optionally, code and world model are co-designed for predictability.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{3}{\textbf {Conditional Trajectory Abstraction.} \emph {Top:} at each decision, the history is encoded once into a context $C$ of frozen DINOv2 features, and a frozen policy proposes $K$ action chunks. The world model, a joint-embedding predictor, forecasts for each chunk a short discrete code $\hat S$ of the chunk's entire future segment, conditioned on $C$. A reader that sees $C$ and the code, but never the action, scores each code against goal images. Since codes do not depend on the goal, one prediction per candidate serves any number of goals. \emph {Bottom:} during training, a target encoder compresses the actual future segment into the code given $C$. A reader ranks sibling candidates by their progress labels, and a decoder reconstructs the future's frozen features from $(C,S)$. The world model learns to predict the stop-gradient code; optionally, code and world model are co-designed for predictability.\relax }{figure.caption.1}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][2][]3}}
